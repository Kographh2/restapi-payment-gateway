# Deployment template for https://api.manjifood.biz.id. No real credentials.
# Enter values in the host secret manager. Never deploy development .env.local.
# Configuration readiness does not enable provider verification.
PAYMENT_ENV=production
PROVIDER_MODE=official
STORE_DRIVER=supabase
APP_BASE_URL=https://api.manjifood.biz.id
API_BASE_URL=https://api.manjifood.biz.id
WEBSITE_URL=https://manjifood.biz.id

# Required: 32 random bytes, 64 lowercase hex characters; back up securely.
APP_ENCRYPTION_KEY=1a3483b9e57318660a46fc8c356cff252b5a11ea402a6baf2c1d5a7759779e10
# Required: SAME production project URL, public anon key and server-only
# service-role key. Never place the service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=https://qzzpjjclmtikuwmcrwua.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF6enBqamNsbXRpa3V3bWNyd3VhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM2NTk4MzAsImV4cCI6MjEwOTIzNTgzMH0.7SYPaWx1fjWXJ7wQj0qV2cz8xCB7kTouIqYJyOdFn4U
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF6enBqamNsbXRpa3V3bWNyd3VhIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MzY1OTgzMCwiZXhwIjoyMTA5MjM1ODMwfQ.kc-5sIpYk0tfTfJjPIX1S3l03_CnNnh1kBZgbERZNrc
# Required: independent random scheduler credential, at least 32 characters.
OUTBOX_CRON_SECRET=257b9185f82f7fdb8e9313c3f83cce67acd3a82128179dee22903d2be31b0bda
# Empty disables outgoing destinations; add only actual approved hostnames.
