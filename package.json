{
  "name": "@manji/api",
  "private": true,
  "version": "0.2.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts tests packages --max-warnings 0",
    "check:env": "node --import ./scripts/register-typescript.mjs scripts/check-env.ts",
    "check:database": "node --import ./scripts/register-typescript.mjs scripts/check-database.ts",
    "test:env": "node --import ./scripts/register-typescript.mjs --test --experimental-test-isolation=none tests/environment.test.ts",
    "test:deployment": "node --import ./scripts/register-typescript.mjs --test --experimental-test-isolation=none tests/deployment.test.ts tests/signed-artifact.test.ts",
    "test:registration": "node --import ./scripts/register-typescript.mjs --test --experimental-test-isolation=none tests/registration.test.ts tests/registration-sql.test.ts"
  },
  "dependencies": {
    "@manji/contracts": "file:./packages/contracts",
    "@manji/validation": "file:./packages/validation",
    "@manji/shared-types": "file:./packages/shared-types",
    "@next/env": "15.5.28",
    "@electric-sql/pglite": "0.3.15",
    "@merchant/shared": "file:./packages/shared",
    "@supabase/supabase-js": "^2.80.0",
    "next": "15.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
